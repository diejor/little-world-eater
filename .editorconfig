root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{gd,gdshader,gdshaderinc}]
indent_style = tab
indent_size = 4

[*.{tscn,tres,godot,import,cfg}]
indent_style = tab
trim_trailing_whitespace = false

[*.cs]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md,svg}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
